# Default: labeled mock integrations, real local negotiation.
# Each live adapter requires authorization, ALLOW_LIVE_CALLS=true, and its credentials.
# REQUIRE_LIVE_INTEGRATIONS=true additionally requires both modes live and successful evidence.
# Copy to .env and restart. Never paste keys into chat.
PORT=4317
REQUIRE_LIVE_INTEGRATIONS=false
ALLOW_LIVE_CALLS=false
PARALLEL_MODE=fixture
PARALLEL_API_KEY=
COMPOSIO_MODE=fixture
COMPOSIO_API_KEY=
COMPOSIO_GOOGLESHEETS_AUTH_CONFIG_ID=

# Existing authorized Google Sheets connections, one selected synthetic workload sheet per owner.
# Use a demo-only account and read-only spreadsheet scope. Do not expand permissions silently.
# Each selected sheet must have tab Workload and four key/value rows in A1:B4:
# gpuCount | 1
# minVramGb | 24
# runtimeMinutes | 60 (Alice) or 120 (Bob)
# trustClass | public-demo
COMPOSIO_ALICE_USER_ID=
COMPOSIO_ALICE_CONNECTED_ACCOUNT_ID=
COMPOSIO_ALICE_WORKLOAD_ID=
COMPOSIO_BOB_USER_ID=
COMPOSIO_BOB_CONNECTED_ACCOUNT_ID=
COMPOSIO_BOB_WORKLOAD_ID=

# Explicit test-only offline mode; never used as fallback after live failure.
# REQUIRE_LIVE_INTEGRATIONS=false
# PARALLEL_MODE=fixture
# COMPOSIO_MODE=fixture
