{
  "name": "concord-agent-coordination",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.22.3"
  },
  "scripts": {
    "dev": "tsx server/index.ts",
    "build": "tsc --noEmit && vite build",
    "start": "NODE_ENV=production tsx server/index.ts",
    "test": "vitest run tests",
    "test:watch": "vitest",
    "check": "npm test && npm run build",
    "smoke": "tsx scripts/smoke.ts",
    "verify:live": "tsx scripts/verify-live.ts",
    "verify:composio": "tsx scripts/verify-composio.ts",
    "format": "prettier --write src server agents tests scripts docs *.json *.ts *.md index.html",
    "format:check": "prettier --check src server agents tests scripts docs *.json *.ts *.md index.html",
    "agent": "tsx agents/relay.ts"
  },
  "dependencies": {
    "@composio/core": "0.25.0",
    "@fontsource/dm-sans": "5.3.0",
    "@fontsource/manrope": "5.3.0",
    "dotenv": "18.0.8",
    "express": "5.3.0",
    "lucide-react": "1.59.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/supertest": "7.2.1",
    "@vitejs/plugin-react": "6.1.2",
    "prettier": "3.9.10",
    "supertest": "7.3.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
